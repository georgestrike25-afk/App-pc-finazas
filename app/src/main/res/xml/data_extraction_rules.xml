<?xml version="1.0" encoding="utf-8"?>
<!-- Las preferencias (perfiles y ajustes) pueden viajar en la copia de seguridad; la caché meteorológica no. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/aura.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/aura.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
