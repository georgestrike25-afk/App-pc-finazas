<?xml version="1.0" encoding="utf-8"?>
<!-- Widget chico de Brote (2 × 2): plata hasta cobrar y botón para anotar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/brote_marca" />

        <TextView
            android:id="@+id/w_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/w_chip_ok"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Al día"
            android:textColor="@color/brote_ok"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Plata hasta cobrar"
        android:textColor="@color/brote_texto2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/w_plata"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/brote_texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_anotar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/w_btn_main"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mas"
            android:tint="@color/brote_primario_texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Anotar"
            android:textColor="@color/brote_primario_texto"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
